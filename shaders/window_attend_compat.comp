#version 460
// 8x8 window cosine attention for the compatibility backend: the same function as window_attend.comp, bit for
// bit, with the two tensor-core products emulated (exact_mma.glsl):
//   S = prior + Q K^T     per element: the prior seeds the f16 accumulator, two F13 groups over the 32 components
//   w = expWeight(S), the specified softmax reduction, E4M3 weights = w * f16(1 / sum)
//   O = P V               per element: four F13 groups over the 64 physical keys, from zero
// Keys are in physical (4x4-tiled) order throughout, as in the native kernel.
#extension GL_EXT_shader_explicit_arithmetic_types : require
#extension GL_GOOGLE_include_directive : require
#include "exact_mma.glsl"

layout(local_size_x = 128) in;

layout(push_constant) uniform Push {
  uint width;
  uint height;
  uint channels;
  uint heads;
  uint shiftX;
  uint shiftY;
  uint windowsX;
  uint windowCount;
} pc;

layout(std430, binding = 0) readonly buffer Normalized { uint8_t qkv[]; };
layout(std430, binding = 1) readonly buffer Prior { float16_t prior[]; };
layout(std430, binding = 5) writeonly buffer Attended { uint8_t attended[]; };

shared uvec4 qs[64 * 2];           // [query][16-component half]: sixteen E4M3 codes per uvec4
shared uvec4 ks[64 * 2];           // [physical key][half]
shared uvec4 vs[4 * 32];           // [16-key group][component]: the sixteen keys of a group for one component
shared float scores[64 * 64];          // half values, held in f32
shared uvec4 weights[64 * 4];      // [query][16-key group]

uint inverseTiledToken(uint token) {
  uint tile = token >> 4u, within = token & 15u;
  uint x = (tile & 1u) * 4u + (within & 3u);
  uint y = (tile >> 1u) * 4u + (within >> 2u);
  return y * 8u + x;
}

// Every half operation below is evaluated in f32 (exact, or one rounding) and published with the bit-level
// roundF16, so that no rounding is left to the compiler (see window_normalize_compat.comp).
float expWeight(float score) {
  // the product is exact in f32 (a half times 23 * 2^-9), so the f32 fma rounds once before the half publication
  float affine = clamp(roundF16(fma(score, 0.044921875, 1.30078125)), 1.03125, 1.5693359375);
  return float(f16FromBits(((f16Bits(float16_t(affine)) << 5u) + 0x8000u) & 0xffffu));
}

float addHalf32(float a, float b) { return roundF16(a + b); }

float softmaxPair(uint row, uint pair, uint parity) {
  uint key = row * 64u + pair * 2u + parity;
  float a = addHalf32(scores[key], scores[key + 8u]);
  float b = addHalf32(scores[key + 16u], scores[key + 24u]);
  float c = addHalf32(scores[key + 32u], scores[key + 40u]);
  float d = addHalf32(scores[key + 48u], scores[key + 56u]);
  return addHalf32(addHalf32(addHalf32(a, b), c), d);
}

float softmaxSum(uint row) {
  float even = addHalf32(addHalf32(addHalf32(softmaxPair(row, 0u, 0u), softmaxPair(row, 1u, 0u)), softmaxPair(row, 2u, 0u)), softmaxPair(row, 3u, 0u));
  float odd = addHalf32(addHalf32(addHalf32(softmaxPair(row, 0u, 1u), softmaxPair(row, 1u, 1u)), softmaxPair(row, 2u, 1u)), softmaxPair(row, 3u, 1u));
  return addHalf32(even, odd);
}

uint packCodes(uint c0, uint c1, uint c2, uint c3) { return c0 | (c1 << 8u) | (c2 << 16u) | (c3 << 24u); }

void main() {
  uint thread = gl_LocalInvocationID.x;
  uint head = gl_WorkGroupID.x;
  uint window = gl_WorkGroupID.y + gl_WorkGroupID.z * 65535u;
  if (window >= pc.windowCount) return;
  int windowX = int((window % pc.windowsX) * 8u) - int(pc.shiftX);
  int windowY = int((window / pc.windowsX) * 8u) - int(pc.shiftY);
  uint stride3 = pc.channels * 3u;
  uint headBase = head * 96u;

  // Stage Q (query order) and K (physical key order) as sixteen-code words: one thread per (token, 16-part).
  {
    uint token = thread >> 1u, part = thread & 1u;
    int qx = windowX + int(token & 7u), qy = windowY + int(token >> 3u);
    uvec4 q = uvec4(0u);
    if (qx >= 0 && qy >= 0 && qx < int(pc.width) && qy < int(pc.height)) {
      uint base = (uint(qy) * pc.width + uint(qx)) * stride3 + headBase + part * 16u;
      for (uint w = 0u; w < 4u; ++w)
        q[w] = packCodes(uint(qkv[base + w * 4u]), uint(qkv[base + w * 4u + 1u]), uint(qkv[base + w * 4u + 2u]), uint(qkv[base + w * 4u + 3u]));
    }
    qs[token * 2u + part] = q;
    uint keyLocal = inverseTiledToken(token);
    int kx = windowX + int(keyLocal & 7u), ky = windowY + int(keyLocal >> 3u);
    uvec4 k = uvec4(0u);
    if (kx >= 0 && ky >= 0 && kx < int(pc.width) && ky < int(pc.height)) {
      uint base = (uint(ky) * pc.width + uint(kx)) * stride3 + headBase + 32u + part * 16u;
      for (uint w = 0u; w < 4u; ++w)
        k[w] = packCodes(uint(qkv[base + w * 4u]), uint(qkv[base + w * 4u + 1u]), uint(qkv[base + w * 4u + 2u]), uint(qkv[base + w * 4u + 3u]));
    }
    ks[token * 2u + part] = k;
  }
  // V transposed into groups of sixteen keys per component: one thread per (group, component).
  {
    uint group = thread >> 5u, component = thread & 31u;
    uint codes[16];
    for (uint i = 0u; i < 16u; ++i) {
      uint keyLocal = inverseTiledToken(group * 16u + i);
      int kx = windowX + int(keyLocal & 7u), ky = windowY + int(keyLocal >> 3u);
      codes[i] = (kx >= 0 && ky >= 0 && kx < int(pc.width) && ky < int(pc.height))
                     ? uint(qkv[(uint(ky) * pc.width + uint(kx)) * stride3 + headBase + 64u + component]) : 0u;
    }
    vs[group * 32u + component] = uvec4(packCodes(codes[0], codes[1], codes[2], codes[3]), packCodes(codes[4], codes[5], codes[6], codes[7]),
                                        packCodes(codes[8], codes[9], codes[10], codes[11]), packCodes(codes[12], codes[13], codes[14], codes[15]));
  }
  barrier();

  // S = prior + Q K^T, then the exponential weight.
  for (uint i = thread; i < 64u * 64u; i += 128u) {
    uint query = i >> 6u, key = i & 63u;
    float16_t s = prior[head * 4096u + i];
    s = adaFp8Fdpa16(qs[query * 2u], ks[key * 2u], s);
    s = adaFp8Fdpa16(qs[query * 2u + 1u], ks[key * 2u + 1u], s);
    scores[i] = expWeight(float(s));
  }
  barrier();

  if (thread < 64u) {
    uint row = thread;
    float reciprocal = float(reciprocalF16(float16_t(softmaxSum(row))));
    for (uint group = 0u; group < 4u; ++group) {
      uint codes[16];
      for (uint i = 0u; i < 16u; ++i) {
        float normalized = roundF16(scores[row * 64u + group * 16u + i] * reciprocal);
        codes[i] = e4m3CodeFromF16Bits(f16Bits(float16_t(normalized)));
      }
      weights[row * 4u + group] = uvec4(packCodes(codes[0], codes[1], codes[2], codes[3]), packCodes(codes[4], codes[5], codes[6], codes[7]),
                                        packCodes(codes[8], codes[9], codes[10], codes[11]), packCodes(codes[12], codes[13], codes[14], codes[15]));
    }
  }
  barrier();

  // O = P V: four groups of sixteen keys in physical order, from zero.
  for (uint i = thread; i < 64u * 32u; i += 128u) {
    uint query = i >> 5u, component = i & 31u;
    int qx = windowX + int(query & 7u), qy = windowY + int(query >> 3u);
    if (qx < 0 || qy < 0 || qx >= int(pc.width) || qy >= int(pc.height)) continue;
    float16_t value = float16_t(0.0);
    for (uint group = 0u; group < 4u; ++group) value = adaFp8Fdpa16(weights[query * 4u + group], vs[group * 32u + component], value);
    uint outputIndex = (uint(qy) * pc.width + uint(qx)) * pc.channels + head * 32u + component;
    attended[outputIndex] = uint8_t(e4m3CodeFromF16Bits(f16Bits(value)));
  }
}
