+// motion vectors: the first write of a pose after a frame consumed the previous one goes to the
+// other buffer of the pair, so that the consumed pose survives as "previous"
+template<typename T>
+static void rotateVelocityBuffers(T& pair) noexcept {
+    if (pair.prevHandle && !pair.dirty) {
+        std::swap(pair.handle, pair.prevHandle);
+        pair.dirty = true;
+    }
+}
+
+template<typename T>
