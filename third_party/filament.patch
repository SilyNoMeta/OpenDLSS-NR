+bool VulkanDriver::runVulkanInterop(
+        utils::Invocable<void(VulkanInteropContext&)>& command) noexcept {
+    struct Context final : public VulkanInteropContext {
+        VulkanDriver& driver;
+        explicit Context(VulkanDriver& driver) : driver(driver) {}
+        VkDevice getDevice() const noexcept override { return driver.mPlatform->getDevice(); }
+        VkQueue getGraphicsQueue() const noexcept override {
+            return driver.mPlatform->getGraphicsQueue();
+        }
+        VkCommandBuffer getCommandBuffer() noexcept override {
+            return driver.mCommands.get().buffer();
+        }
+        VulkanInteropTexture getTexture(uint32_t const textureHandle) noexcept override {
+            if (!textureHandle) {
+                return {};
+            }
+            auto texture = resource_ptr<VulkanTexture>::cast(&driver.mResourceManager,
+                    Handle<HwTexture>{ textureHandle });
+            VkImageSubresourceRange const& range = texture->getPrimaryViewRange();
+            return {
+                .image = texture->getVkImage(),
+                .format = texture->getVkFormat(),
+                .layout = fvkutils::getVkLayout(texture->getLayout(0, 0)),
+                .aspect = range.aspectMask,
+                .width = texture->width,
+                .height = texture->height,
+                .levels = texture->levels,
+                .layers = range.layerCount,
+            };
+        }
+        void setTextureLayout(uint32_t const textureHandle, VkImageLayout const layout) noexcept override {
+            if (!textureHandle) {
+                return;
+            }
+            auto texture = resource_ptr<VulkanTexture>::cast(&driver.mResourceManager,
+                    Handle<HwTexture>{ textureHandle });
+            bool const isDepth = fvkutils::isVkDepthFormat(texture->getVkFormat());
+            VulkanLayout tracked = VulkanLayout::UNDEFINED;
+            switch (layout) {
+                case VK_IMAGE_LAYOUT_GENERAL:
+                    tracked = isDepth ? VulkanLayout::DEPTH_SAMPLER : VulkanLayout::STAGING;
+                    break;
+                case VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL:
+                    tracked = VulkanLayout::FRAG_READ;
+                    break;
+                case VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL:
+                    tracked = VulkanLayout::TRANSFER_SRC;
+                    break;
+                case VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL:
+                    tracked = VulkanLayout::TRANSFER_DST;
+                    break;
+                case VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL:
+                    tracked = VulkanLayout::COLOR_ATTACHMENT;
+                    break;
+                case VK_IMAGE_LAYOUT_DEPTH_STENCIL_ATTACHMENT_OPTIMAL:
+                    tracked = VulkanLayout::DEPTH_STENCIL_ATTACHMENT;
+                    break;
+                case VK_IMAGE_LAYOUT_PRESENT_SRC_KHR:
+                    tracked = VulkanLayout::PRESENT;
+                    break;
+                default:
+                    break;
+            }
+            VkImageSubresourceRange range = texture->getPrimaryViewRange();
+            range.baseMipLevel = 0;
+            range.levelCount = texture->levels;
+            texture->setLayout(range, tracked);
+        }
+    };
+    Context context{ *this };
+    if (command) {
+        command(context);
+        // Executing secondary buffers invalidates the primary's bindings. The interop callback
+        // may also bind pipelines / descriptors directly, outside Filament's state cache.
+        invalidateBoundState();
+    }
+    return true;
+}
