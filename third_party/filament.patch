+#ifndef TNT_FILAMENT_BACKEND_VULKANINTEROP_H
+#define TNT_FILAMENT_BACKEND_VULKANINTEROP_H
+
+#include <bluevk/BlueVK.h>
+
+#include <utils/Invocable.h>
+
+#include <stdint.h>
+
+namespace filament::backend {
+
+/**
+ * A Filament texture as the Vulkan backend holds it (VulkanInteropContext::getTexture()).
+ */
+struct VulkanInteropTexture {
+    VkImage image = VK_NULL_HANDLE;
+    VkFormat format = VK_FORMAT_UNDEFINED;
+    VkImageLayout layout = VK_IMAGE_LAYOUT_UNDEFINED;   // the layout the backend tracks for level 0
+    VkImageAspectFlags aspect = 0;
+    uint32_t width = 0;
+    uint32_t height = 0;
+    uint32_t levels = 0;
+    uint32_t layers = 0;
+};
+
+/**
+ * What a command queued with Engine::queueVulkanCommand() runs with, on the backend thread.
+ *
+ * The command is responsible for the synchronization of what it records (pipeline barriers, layout
+ * transitions). Filament tracks the layout of its textures: after changing one, the command must
+ * report the new layout with setTextureLayout(), so that the backend's next transition starts
+ * from the right layout.
+ */
+class VulkanInteropContext {
+public:
+    virtual VkDevice getDevice() const noexcept = 0;
+    virtual VkQueue getGraphicsQueue() const noexcept = 0;
+
+    /** the command buffer the backend is recording, outside of any render pass */
+    virtual VkCommandBuffer getCommandBuffer() noexcept = 0;
+
+    /** a texture, by the handle Engine::getVulkanInteropTextureHandle() returned */
+    virtual VulkanInteropTexture getTexture(uint32_t textureHandle) noexcept = 0;
+
+    /** reports a layout change of the whole image that the command recorded itself */
+    virtual void setTextureLayout(uint32_t textureHandle, VkImageLayout layout) noexcept = 0;
+
+protected:
+    ~VulkanInteropContext() = default;
+};
+
+using VulkanInteropCommand = utils::Invocable<void(VulkanInteropContext&)>;
+
+} // namespace filament::backend
+
+#endif // TNT_FILAMENT_BACKEND_VULKANINTEROP_H
