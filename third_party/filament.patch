+void FView::prepareVelocityHistory(CameraInfo& cameraInfo, uint32_t const frameId) noexcept {
+    // clip <- eye <- head <- world, for the first eye (identity eyeFromView when monoscopic)
+    mat4f const clipFromWorld = highPrecisionMultiply(cameraInfo.eyeProjection[0],
+            highPrecisionMultiply(cameraInfo.eyeFromView[0], cameraInfo.view));
+    auto& history = mVelocityHistory;
+    bool const hasPrevious = history.frameId != 0 && history.frameId + 1 == frameId;
+    cameraInfo.prevClipFromWorld = hasPrevious ? history.clipFromWorld : clipFromWorld;
+    if (history.frameId != frameId) {
+        history.clipFromWorld = clipFromWorld;
+        history.frameId = frameId;
+    }
+}
